---
import IdBadge from './IdBadge.astro';
import CopyEmail from './CopyEmail.astro';
import { useT } from '@/i18n/ui';
import { routes } from '@/i18n/routes';
import { profile, cvFor } from '@/lib/content';
import type { Locale } from '@/lib/content/schema';

interface Props {
  locale: Locale;
  /** id da secção para onde aponta o botão de descer. */
  next?: string;
}
const { locale, next } = Astro.props;
const t = useT(locale);
const text = profile.i18n[locale];
// O cargo é o título grande; a última palavra fica sobre menta (ex.: "Developer" / "full-stack").
const roleWords = text.roleLine.split(' ');
const roleLast = roleWords.pop() ?? '';
const roleLead = roleWords.join(' ');
// A parte depois do travessão é realçada (ex.: "... — da base de dados à interface.").
const [lead, emphasis] = text.headline.split(' — ');
const cv = cvFor(locale);
---
<section class="hero texture" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1 id="hero-title">
        <span class="display">
          {roleLead && <span class="line">{roleLead}</span>}
          <span class="line"><span class="mark">{roleLast}</span></span>
        </span>
        <span class="visually-hidden">: </span>
        <span class="lede">{emphasis ? (<>{lead} — <strong>{emphasis}</strong></>) : text.headline}</span>
      </h1>
      <div class="ctas">
        <a class="btn btn--primary" href={routes.projects[locale]}>{t('cta.projects')}</a>
        {cv && <a class="btn" href={cv.href} hreflang={cv.fallback ? (locale === 'pt' ? 'en' : 'pt') : undefined}>{cv.fallback ? t('cta.cvOther') : t('cta.cv')}</a>}
        <CopyEmail locale={locale} email={profile.email} />
      </div>
    </div>
    <IdBadge locale={locale} />
  </div>
  {next && (
    <a class="scroll-cue" href={`#${next}`}>
      <span class="visually-hidden">{t('hero.next')}</span>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
    </a>
  )}
</section>

<style>
  /* o fundo de ondas vem da classe global .texture */
  .hero { padding-block: var(--space-6) var(--space-7); }
  .hero-inner { display: grid; gap: var(--space-7); align-items: center; }
  .hero-text { container-type: inline-size; display: grid; gap: var(--space-6); min-width: 0; }

  h1 { display: grid; gap: var(--space-5); max-width: none; }
  .display {
    display: grid;
    justify-items: start;
    font-weight: 800;
    /* ~19cqi faz a linha mais larga ("FULL-STACK", ~4,8em) ocupar ~90% da coluna */
    font-size: clamp(2.75rem, 19cqi, 9.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }
  .line { white-space: nowrap; }
  .mark {
    display: inline-block;
    margin-top: 0.06em;
    padding: 0.04em 0.06em 0;
    margin-left: -0.06em;
    background: var(--mint);
    color: var(--on-mint);
  }
  .lede {
    max-width: 38ch;
    font: 400 var(--step-1)/1.45 var(--font-body);
    letter-spacing: normal;
    color: var(--muted);
    text-wrap: pretty;
  }
  .lede strong { font-weight: 600; color: var(--ink); }

  .ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }

  .scroll-cue {
    display: none;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin: var(--space-7) auto 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    transition: border-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease);
  }
  .scroll-cue:hover { border-color: var(--ink); transform: translateY(3px); }

  @media (min-width: 52rem) {
    .hero {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: min(calc(100svh - 6.5rem), 54rem);
      padding-block: 0 var(--space-6);
    }
    .hero-inner { grid-template-columns: minmax(0, 1fr) 20rem; gap: var(--space-7); align-items: start; }
    .hero-text { align-self: center; padding-top: var(--space-6); }
    /* a fita começa no topo do hero */
    .hero-inner > :global([data-badge]) { margin-top: calc(-1 * var(--space-5)); }
    .scroll-cue { display: grid; }
  }
</style>
