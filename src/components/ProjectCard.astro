---
import { Picture } from 'astro:assets';
import { useT } from '@/i18n/ui';
import { projectPath } from '@/i18n/routes';
import { imageOf, categoryName } from '@/lib/content';
import type { Locale, Project } from '@/lib/content/schema';

interface Props { project: Project; locale: Locale; headingLevel?: 'h2' | 'h3'; priority?: boolean; span?: 'wide' | 'narrow' | 'full' }
const { project, locale, headingLevel = 'h3', priority = false, span } = Astro.props;
const t = useT(locale);
const text = project.i18n[locale];
const Heading = headingLevel;
---
<article class="card" data-category={project.category} data-span={span}>
  <Picture
    src={imageOf(project.cover)}
    alt={project.cover.i18n[locale].alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1600]}
    sizes="(min-width: 64rem) 60vw, (min-width: 40rem) 90vw, 100vw"
    width={1200}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
    class="cover"
  />
  <p class="category">{categoryName(project.category, locale)}</p>
  <div class="body">
    <Heading class="title"><a href={projectPath(project.slug, locale)}>{text.title}</a></Heading>
    <span class="cta" aria-hidden="true">
      {t('project.view')}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
    </span>
  </div>
</article>

<style>
  /* cartão de capa: só a imagem; ao passar o rato (ou com foco) sobe um véu menta com o título */
  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: var(--card-ratio, 4 / 5);
    min-height: 22rem;
    border-radius: 22px;
    overflow: hidden;
    background: #141518;
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.45);
    transition: box-shadow var(--dur-3) var(--ease), transform var(--dur-3) var(--ease);
  }
  .card :global(.cover) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }
  /* véu menta: a menta é clara nos dois temas, por isso o texto por cima usa --on-mint */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(184 247 228 / 0.96), rgb(184 247 228 / 0.82) 30%, rgb(184 247 228 / 0) 62%);
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease);
  }

  .category {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    padding: 0.45rem 0.85rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: var(--radius-pill);
    background: rgb(12 13 15 / 0.55);
    color: #fff;
    font: 600 0.8125rem/1 var(--font-body);
    letter-spacing: 0.02em;
  }

  .body {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: clamp(1.25rem, 3vw, 2rem);
    color: var(--on-mint);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity var(--dur-3) var(--ease), transform var(--dur-3) var(--ease);
  }
  .title {
    font-size: clamp(1.625rem, 1.1rem + 1.6vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .title a { color: inherit; text-decoration: none; }
  /* toda a área do cartão é clicável, mantendo um único link acessível */
  .title a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .title a:focus-visible { outline: none; }
  .card:has(.title a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 4px; }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: 700 0.8125rem/1 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cta svg { transition: transform var(--dur-2) var(--ease); }

  /* revelar: rato por cima ou foco do teclado */
  .card:hover::before, .card:focus-within::before { opacity: 1; }
  .card:hover .body, .card:focus-within .body { opacity: 1; transform: none; }

  /* ecrãs táteis não têm hover: o véu e o título ficam sempre visíveis */
  @media (hover: none) {
    .card::before { opacity: 1; }
    .body { opacity: 1; transform: none; }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .card:hover { transform: translateY(-4px); box-shadow: 0 36px 64px -30px rgb(0 0 0 / 0.55); }
    .card:hover :global(.cover) { transform: scale(1.04); }
    .card:hover .cta svg { transform: translate(3px, -3px); }
  }
</style>
