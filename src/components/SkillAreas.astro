---
import { useT, type UiKey } from '@/i18n/ui';
import { projectPath } from '@/i18n/routes';
import { technologies, experiences, projects } from '@/lib/content';
import { skillRows } from '@/lib/content/evidence';
import type { Locale } from '@/lib/content/schema';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
// cada área é um grupo de tecnologias do painel; a prova vem das experiências e dos projetos publicados
const areas = (['backend', 'data', 'frontend', 'design', 'tools'] as const)
  .map((group) => {
    const names = technologies.filter((tech) => tech.group === group).map((tech) => tech.name);
    return { group, rows: skillRows(names, experiences, projects, locale) };
  })
  .filter((area) => area.rows.length > 0);
---
<div class="areas">
  {areas.map(({ group, rows }) => (
    <section class="area" aria-labelledby={`skills-${group}`}>
      <h3 id={`skills-${group}`}>{t(('group.' + group) as UiKey)}</h3>
      <p class="lead">{t(('skills.' + group) as UiKey)}</p>
      <ul class="rows">
        {rows.map((row) => (
          <li>
            <ul class="tags">{row.names.map((name) => <li class="tag">{name}</li>)}</ul>
            {row.kind === 'professional' && (
              <p class="proof"><span class="proof-kind pro">{t('skills.professional')}</span>{row.organizations.join(' · ')}</p>
            )}
            {row.kind === 'project' && (
              <p class="proof">
                <span class="proof-kind">{t('skills.project')}</span>
                {row.projects.map((p, i) => <>{i > 0 && ' · '}<a href={projectPath(p.slug, locale)}>{p.title}</a></>)}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .areas { display: grid; gap: var(--space-6) var(--space-7); }
  .area { display: grid; gap: var(--space-3); align-content: start; padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .area h3 { font-size: var(--step-2); }
  .lead { color: var(--muted); max-width: 48ch; }
  .rows { display: grid; gap: var(--space-4); margin: var(--space-2) 0 0; padding: 0; list-style: none; }
  .rows > li { display: grid; gap: var(--space-2); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .proof { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-2); font-size: var(--step--1); }
  .proof-kind {
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .proof-kind.pro { border-color: var(--mint); background: var(--mint); color: var(--on-mint); }
  @media (min-width: 52rem) {
    .areas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
