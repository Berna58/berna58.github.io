---
import { useT, type UiKey } from '@/i18n/ui';
import { profile, technologies } from '@/lib/content';
import type { Locale } from '@/lib/content/schema';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const stack = technologies.filter((tech) => tech.group === 'backend' || tech.group === 'data');
const stackLine = stack.filter((tech) => tech.name !== 'PHP' && tech.name !== 'C#').map((tech) => tech.name).join(' · ');
---
<dl class="status-card" aria-label={t('status.label')}>
  <dt>{t('status.state')}</dt>
  <dd><span class:list={['dot', { off: !profile.available }]} aria-hidden="true"></span>{profile.available ? t('status.available') : t('status.unavailable')}</dd>
  <dt>{t('status.mode')}</dt>
  <dd>{profile.workModes.map((mode, i) => <>{i > 0 && ' · '}<span class="nowrap">{t(('workMode.' + mode) as UiKey)}</span></>)}</dd>
  <dt>{t('status.zone')}</dt>
  <dd>{profile.workZones.map((zone, i) => <>{i > 0 && ' · '}<span class="nowrap">{zone}</span></>)}</dd>
  <dt>{t('status.stack')}</dt>
  <dd>{stackLine}</dd>
</dl>

<style>
  .status-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.7;
  }
  dt { color: var(--muted); }
  dd { margin: 0; min-width: 0; }
  .nowrap { white-space: nowrap; }
  .dot {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 2px var(--on-mint);
    vertical-align: 0.05em;
  }
  .dot.off { background: var(--line); }
</style>
