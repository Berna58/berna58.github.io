---
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { useT } from '@/i18n/ui';
import { routes, otherLocale } from '@/i18n/routes';
import { projects, categories } from '@/lib/content';
import type { Locale } from '@/lib/content/schema';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const used = categories
  .map((c) => ({ slug: c.slug, name: c.i18n[locale].name, count: projects.filter((p) => p.category === c.slug).length }))
  .filter((c) => c.count > 0);

// Ritmo da grelha: pares largo+estreito que alternam de lado; um último cartão sozinho ocupa a linha toda.
// O script abaixo aplica a mesma regra aos cartões visíveis depois de filtrar.
const spanFor = (i: number, n: number) => {
  if (n % 2 === 1 && i === n - 1) return 'full';
  const first = i % 2 === 0;
  return Math.floor(i / 2) % 2 === 0 ? (first ? 'wide' : 'narrow') : (first ? 'narrow' : 'wide');
};
---
<Base locale={locale} alternatePath={routes.projects[otherLocale(locale)]} title={t('projects.title')} description={t('projects.intro')} current="projects">
  <div class="container page">
    <header class="head">
      <h1>{t('projects.title')}</h1>
    </header>

    {used.length > 1 && (
      <div class="filters" role="group" aria-label={t('projects.filterLabel')} data-filters hidden>
        <button type="button" class="chip" data-filter="" aria-pressed="true">{t('projects.all')} <span class="count">{projects.length}</span></button>
        {used.map((c) => (
          <button type="button" class="chip" data-filter={c.slug} aria-pressed="false">{c.name} <span class="count">{c.count}</span></button>
        ))}
      </div>
    )}

    <p class="visually-hidden" role="status" aria-live="polite" data-filter-status></p>

    <div class="grid" data-grid>
      {projects.map((project, i) => (
        <ProjectCard project={project} locale={locale} headingLevel="h2" priority={i < 2} span={spanFor(i, projects.length)} />
      ))}
    </div>
  </div>
</Base>

<script>
  // Filtro progressivo: sem JavaScript todos os projetos ficam visíveis.
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  if (bar && grid) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-category]')];
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    // um nome por cartão para a View Transition os deslocar em vez de só fazer fade da página
    cards.forEach((card, i) => card.style.setProperty('view-transition-name', `project-card-${i}`));

    // mesma regra de spanFor (frontmatter), aplicada só aos cartões visíveis
    const relayout = () => {
      const visible = cards.filter((card) => !card.hidden);
      const n = visible.length;
      visible.forEach((card, i) => {
        const first = i % 2 === 0;
        card.dataset.span = n % 2 === 1 && i === n - 1
          ? 'full'
          : Math.floor(i / 2) % 2 === 0 ? (first ? 'wide' : 'narrow') : (first ? 'narrow' : 'wide');
      });
    };

    const apply = (slug: string, animate = true) => {
      const update = () => {
        for (const card of cards) card.hidden = Boolean(slug) && card.dataset.category !== slug;
        relayout();
      };
      // a View Transition anima a grelha a reorganizar-se; sem suporte (ou com movimento reduzido) muda logo
      if (animate && 'startViewTransition' in document && !reduceMotion.matches) document.startViewTransition(update);
      else update();

      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === slug));
      const active = buttons.find((b) => b.dataset.filter === slug);
      if (status && active) status.textContent = active.textContent?.trim() ?? '';
      const url = new URL(location.href);
      if (slug) url.searchParams.set('categoria', slug);
      else url.searchParams.delete('categoria');
      history.replaceState(null, '', url);
    };
    for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.filter ?? ''));
    const initial = new URL(location.href).searchParams.get('categoria') ?? '';
    if (buttons.some((b) => b.dataset.filter === initial)) apply(initial, false);
  }
</script>

<style>
  .page { display: grid; gap: var(--space-5); padding-block: var(--space-6) var(--space-9); }

  .head { padding-bottom: var(--space-5); border-bottom: 1px solid var(--line); }
  .head h1 { font-size: clamp(3rem, 1.6rem + 6vw, 6rem); line-height: 0.9; letter-spacing: -0.04em; }

  .filters { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .filters[hidden] { display: none; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font: 600 var(--step--1)/1 var(--font-body);
    cursor: pointer;
    transition: background var(--dur-2) var(--ease), color var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease);
  }
  .chip:hover { border-color: var(--ink); }
  .chip:focus-visible { border-radius: var(--radius-pill); }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .count { font: 400 0.75rem/1 var(--font-mono); opacity: 0.7; }

  /* telemóvel: uma coluna de cartões verticais */
  .grid { display: grid; gap: var(--space-4); grid-template-columns: 1fr; }
  .grid :global([hidden]) { display: none; }

  /* tablet: duas colunas; o cartão sozinho no fim fica panorâmico */
  @media (min-width: 40rem) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-5); }
    .grid :global([data-span="full"]) { grid-column: 1 / -1; --card-ratio: 16 / 9; }
  }

  /* desktop: bento de 12 colunas com alturas fixas por linha */
  @media (min-width: 60rem) {
    .grid { grid-template-columns: repeat(12, 1fr); grid-auto-rows: clamp(24rem, 32vw, 32rem); }
    .grid :global(.card) { aspect-ratio: auto; min-height: 0; }
    .grid :global([data-span="wide"]) { grid-column: span 7; }
    .grid :global([data-span="narrow"]) { grid-column: span 5; }
    .grid :global([data-span="full"]) { grid-column: 1 / -1; }
  }

  ::view-transition-group(*) { animation-duration: var(--dur-3); animation-timing-function: var(--ease); }
</style>
