---
import { useT, type UiKey } from '@/i18n/ui';
import { profile, technologies } from '@/lib/content';
import type { Locale } from '@/lib/content/schema';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const text = profile.i18n[locale];
const stack = technologies.filter((tech) => tech.group === 'backend' || tech.group === 'data');
const stackLine = stack.filter((tech) => tech.name !== 'PHP' && tech.name !== 'C#').map((tech) => tech.name).join(' · ');

// Código de barras decorativo, sempre igual para o mesmo nome (sem aleatoriedade entre builds).
const bars: { x: number; w: number }[] = [];
let x = 0;
for (const char of (profile.fullName + profile.email).replace(/\s/g, '')) {
  const code = char.charCodeAt(0);
  const w = 1 + (code % 3);
  bars.push({ x, w });
  x += w + 1 + ((code >> 2) % 3);
}
const barcodeWidth = x;
---
<div class="badge-wrap" data-badge>
  <div class="badge-tilt">
    <div class="badge-swing">
      <span class="strap" aria-hidden="true"></span>
      <div class="card" role="group" aria-label={t('status.label')}>
        <span class="ring" aria-hidden="true"></span>
        <div class="card-top">
          <p class="state"><span class:list={['dot', { off: !profile.available }]} aria-hidden="true"></span>{profile.available ? t('status.available') : t('status.unavailable')}</p>
          <span class="serial" aria-hidden="true">DEV · 0001</span>
        </div>
        <!-- o logo é o próprio favicon, para ficarem sempre iguais -->
        <img class="mark" src="/foto.jpeg" alt="" width="76" height="76" />

        <p class="name">{profile.fullName}</p>
        <p class="role">{text.roleLine}</p>
        <dl class="meta">
          <dt class="visually-hidden">{t('status.stack')}</dt>
          <dd class="stack">{stackLine}</dd>
          <dt class="visually-hidden">{t('status.mode')}</dt>
          <dd>{profile.workModes.map((mode) => t(('workMode.' + mode) as UiKey)).join(' · ')}</dd>
          <dt class="visually-hidden">{t('status.zone')}</dt>
          <dd>{text.location}</dd>
        </dl>
        <svg class="barcode" aria-hidden="true" viewBox={`0 0 ${barcodeWidth} 20`} preserveAspectRatio="none">
          {bars.map((bar) => <rect x={bar.x} y="0" width={bar.w} height="20" fill="currentColor" />)}
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  // Inclinação ligeira do crachá a seguir o rato. Só com rato fino e sem pedido de movimento reduzido.
  const wrap = document.querySelector<HTMLElement>('[data-badge]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wrap && finePointer && !reduced) {
    let frame = 0;
    window.addEventListener('pointermove', (event) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const box = wrap.getBoundingClientRect();
        const offset = (event.clientX - (box.left + box.width / 2)) / window.innerWidth;
        const tilt = Math.max(-1, Math.min(1, offset * 2)) * -5;
        wrap.style.setProperty('--tilt', `${tilt.toFixed(2)}deg`);
      });
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => wrap.style.setProperty('--tilt', '0deg'));
  }
</script>

<style>
  .badge-wrap { --tilt: 0deg; --strap: 7rem; display: flex; justify-content: center; }
  .badge-tilt, .badge-swing { transform-origin: 50% 0; }
  .badge-tilt { transform: rotate(var(--tilt)); transition: transform 900ms cubic-bezier(0.25, 1.4, 0.5, 1); }
  .badge-swing { display: flex; flex-direction: column; align-items: center; animation: swing 2.6s cubic-bezier(0.3, 0.6, 0.3, 1) both; }
  @keyframes swing {
    0% { transform: rotate(9deg); }
    22% { transform: rotate(-6deg); }
    42% { transform: rotate(3.5deg); }
    62% { transform: rotate(-1.8deg); }
    80% { transform: rotate(0.7deg); }
    100% { transform: rotate(0deg); }
  }

  .strap {
    display: block;
    width: 2.5rem;
    height: var(--strap);
    margin-bottom: -0.9rem;
    border-radius: 3px 3px 0 0;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.08), transparent 30% 70%, rgb(0 0 0 / 0.25)),
      repeating-linear-gradient(0deg, #222428 0 3px, #4b4f57 3px 5px);
  }

  .card {
    position: relative;
    width: min(20rem, 100%);
    padding: var(--space-5) var(--space-5) var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 18px;
    background: #141518;
    color: #edf0ef;
    text-align: center;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.12), 0 30px 60px -20px rgb(0 0 0 / 0.45);
  }
  .ring {
    position: absolute;
    top: 0.45rem;
    left: 50%;
    width: 0.8rem;
    height: 0.8rem;
    margin-left: -0.4rem;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.35), 0 0 0 2px #2a2c31;
  }
  .card-top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); margin-bottom: var(--space-5); }
  .state {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font: 600 0.8125rem/1 var(--font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--mint); box-shadow: 0 0 0 3px rgb(184 247 228 / 0.18); }
  .dot.off { background: #6b7078; box-shadow: none; }
  .serial { font: 400 0.75rem/1 var(--font-mono); color: #a9aeb4; }
  .mark { margin: 0 auto var(--space-5); color: var(--mint); }
  .name {
    font: 800 1.6rem/1.05 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .role { margin-top: var(--space-2); font: 600 var(--step--1)/1.3 var(--font-body); letter-spacing: 0.06em; text-transform: uppercase; color: #a9aeb4; }
  .meta {
    margin: var(--space-5) 0 var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px dashed rgb(255 255 255 / 0.22);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .meta dd { margin: 0; color: #a9aeb4; font-family: var(--font-mono); font-size: 0.75rem; }
  .meta dd.stack { color: #edf0ef; font-family: var(--font-body); font-size: var(--step--1); margin-bottom: var(--space-1); }
  .barcode { width: 100%; height: 2.25rem; color: #edf0ef; }

  @media (min-width: 52rem) {
    .badge-wrap { --strap: 11rem; }
  }
</style>
