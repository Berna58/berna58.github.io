---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Coverflow from '@/components/Coverflow.astro';
import AboutIntro from '@/components/AboutIntro.astro';
import ContactSection from '@/components/ContactSection.astro';
import { useT } from '@/i18n/ui';
import { routes, otherLocale } from '@/i18n/routes';
import { profile, technologies, education, projects, featuredProjects, linksFor } from '@/lib/content';
import type { Locale } from '@/lib/content/schema';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const text = profile.i18n[locale];
const featured = featuredProjects();
// com menos de 3 destaques, o carrossel completa-se com os restantes projetos (destaques primeiro)
const showcase = featured.length >= 3 ? featured : [...featured, ...projects.filter((p) => !p.featured)];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  jobTitle: text.roleLine,
  email: 'mailto:' + profile.email,
  url: new URL(routes.home[locale], Astro.site).href,
  sameAs: linksFor('footer').map((l) => l.url),
  alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.institution })),
  knowsAbout: technologies.filter((tech) => tech.group !== 'design').map((tech) => tech.name),
};
---
<Base locale={locale} alternatePath={routes.home[otherLocale(locale)]} current="home" jsonLd={jsonLd}>
  <Hero locale={locale} next={showcase.length > 0 ? 'featured-title' : 'about-intro-title'} />

  {showcase.length > 0 && (
    <section class="section" aria-labelledby="featured-title">
      <div class="container">
        <div class="section-head">
          <h2 id="featured-title" class="visually-hidden">{t('section.featured')}</h2>
        </div>
      </div>
      {showcase.length >= 3 ? (
        <Coverflow projects={showcase} locale={locale} />
      ) : (
        <div class="container grid">
          {showcase.map((project, i) => <ProjectCard project={project} locale={locale} priority={i === 0} />)}
        </div>
      )}
      <div class="section-cta">
        <a class="btn btn--outline" href={routes.projects[locale]}>{t('section.allProjects')}</a>
      </div>
    </section>
  )}

  <AboutIntro locale={locale} />

  <ContactSection locale={locale} />
</Base>

<style>
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3) var(--space-5); margin-bottom: var(--space-6); }
  .section-head a { font-weight: 600; }
  .section-cta { display: flex; justify-content: center; margin-top: var(--space-6); padding-inline: var(--gutter); }
  .grid { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
</style>
