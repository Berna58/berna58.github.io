# Copia para .env e preenche. Valores do Supabase LOCAL (supabase status).
# Em produção, o Vercel recebe estas variáveis da integração Supabase (ver docs/operacao.md).

# Painel /admin no browser: públicas por desenho (o acesso é controlado por RLS + MFA).
PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
PUBLIC_SUPABASE_ANON_KEY=

# Só para correr o build contra um Supabase (export do conteúdo). Nunca commitar valores reais.
# SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
